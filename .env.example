# ─────────────────────────────────────────────────────────────
# THEFATTEST.STORE — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for SEO / canonical / sitemap)
NEXT_PUBLIC_SITE_URL=https://thefattest.store

# WhatsApp Business number in international format, digits only
# (57 + 10-digit mobile). Defaults to the store line +57 310 538 6878.
NEXT_PUBLIC_WHATSAPP_NUMBER=573105386878

# Social profiles (full URLs). Empty = the icon is hidden.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/thefattest.store/
NEXT_PUBLIC_TIKTOK_URL=

# Contact e-mail shown in the footer / contact page. Empty = hidden.
NEXT_PUBLIC_CONTACT_EMAIL=

# "true" marks the catalog as demo inventory (badges + notices).
# Set to "false" only when products/prices/stock are real.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase. Defaults to the THEFATTEST.STORE project (dqzjwdcwblizhpaeertg)
# with its public publishable key — safe in the browser thanks to RLS.
# Set NEXT_PUBLIC_SUPABASE_URL=off to run without a database.
# Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://dqzjwdcwblizhpaeertg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_25E8Am6ghIwYPbgGLAlwFQ_31U_joqn

# Payment gateways (future). Not used yet — see README "Pagos".
# MERCADOPAGO_ACCESS_TOKEN=
# WOMPI_PUBLIC_KEY=
# WOMPI_PRIVATE_KEY=
# PAYU_MERCHANT_ID=
# PAYU_API_KEY=
